IS_DOCKER=true
FLASK_ENV=production

# ===== MySQL =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=leitoclean
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=leitoclean
MYSQL_ROOT_PASSWORD=changeme

# ===== Redis (senha obrigatória) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ===== Flask =====
SECRET_KEY=changeme

# ===== Email =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=changeme@example.com
EMAIL_PASSWORD=changeme

# ===== Vitae (sistema hospitalar integrado) =====
BASE_URL=http://vitae.example.local:8080
USERNAME_VITAE=changeme
PASSWORD_VITAE=changeme

# ===== iControl (RFID) =====
ICONTROL_BASE_URL=https://icontrol.example.local:8889
ICONTROL_LOGIN=changeme
ICONTROL_SENHA=changeme

# ===== Outros =====
INTERVALO_ATUALIZACAO=120
